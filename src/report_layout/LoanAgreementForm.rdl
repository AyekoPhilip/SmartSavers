          <Textbox Name="Textbox29">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>This Loan Agreement (the “Agreement”) is entered into </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!ApplicationDate.Value</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Format>d</Format>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> the Effective Date”), by and between SNAT Savings and Credit Co-Operative Society, with an address of  P. O .Box 1917 Manzini (the “Lender”) and </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!AccountName.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, 	with 	an 	address 	of </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!CustAddress.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, (the “Borrower”), collectively “the Parties.”</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>WHEREAS Borrower desires to borrow a fixed amount of money; and</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>WHEREAS Lender agrees to lend a fixed amount of money;</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <LeftIndent>0.00694in</LeftIndent>
                <HangingIndent>-0.5pt</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>10pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <LeftIndent>0.00694in</LeftIndent>
                <HangingIndent>-0.5pt</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>10pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>IN CONSIDERATION of, the mutual promises, covenants, and conditions contained herein, the Parties agree as follows:</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
