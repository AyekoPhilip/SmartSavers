                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. This Agreement is legal and binding between the Parties as stated above. This Agreement may be entered into and is legal and binding throughout Eswatini. The Parties each represent that they have the authority to enter into this Agreement.</Value>
