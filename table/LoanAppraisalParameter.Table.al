    procedure CopyFromLoanApplication(RecRef: Record "Loan Application")
    begin
        RecRef.CalcFields("Amount Guaranteed", "Total TopUp");

        "No." := RecRef."No.";
        "Minute No." := RecRef.Minute;
        "Account No." := RecRef."Account No.";
        "Account Name" := RecRef."Account Name";
        "Application Date" := RecRef."Application Date";
        "Created By" := RecRef."Captured By";
        "Product Type" := RecRef."Product Type";
        "Payroll/Staff No." := RecRef."Payroll/Staff No.";
        "Employer Code" := RecRef."Employer Code";
        "Product Name" := RecRef."Product Description";
        "Repayment Start Date" := RecRef."Repayment Start Date";
        "Expected Completion Date" := RecRef."Expected Date of Completion";
        "Sacco Deductions" := RecRef."Sacco Deductions";
        Installments := RecRef.Installments;
        Interest := RecRef."Interest Rate";
        "Deposit Purchase" := RecRef."Deposit Purchase";
        Sector := RecRef.Sectors;
        "Sub-Sector" := RecRef."Sub Sectors";
        "Loan Purpose" := RecRef."Purpose of Loan";
        "Balance (LCY)" := RecRef."Savings Balance(LCY)";
        Remarks := RecRef.Remarks;
        "Amount (Requested)" := RecRef."Requested Amount";
        "Total Topup" := RecRef."Total TopUp";
        "Amount Guaranteed" := RecRef."Amount Guaranteed";

    end;
